# SakhiSilai Firebase Configuration Template
# Copy this file to .env.local to configure your Firebase project credentials

VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="sakhisilai.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sakhisilai"
VITE_FIREBASE_STORAGE_BUCKET="sakhisilai.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Optional Backend API Server URL
VITE_API_URL="http://localhost:5000"
